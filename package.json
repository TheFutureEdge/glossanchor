{
  "name": "glossanchor",
  "version": "0.1.0",
  "description": "Lightweight term matching with accessible, SEO-friendly React glossary links.",
  "keywords": [
    "accessibility",
    "glossary",
    "react",
    "seo",
    "ssr",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "Future Edge Group FZE",
    "url": "https://ftredge.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheFutureEdge/glossanchor.git"
  },
  "bugs": {
    "url": "https://github.com/TheFutureEdge/glossanchor/issues"
  },
  "homepage": "https://github.com/TheFutureEdge/glossanchor#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./interaction": {
      "types": "./dist/interaction.d.ts",
      "import": "./dist/interaction.js"
    },
    "./glossary": {
      "types": "./dist/glossary.d.ts",
      "import": "./dist/glossary.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "size:check": "node scripts/check-bundle-size.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run size:check && npm run pack:check"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
